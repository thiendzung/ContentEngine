APP_ENV=development
APP_VERSION=0.1.0-ce01
DATABASE_URL=postgresql+asyncpg://contentengine:contentengine@localhost:5432/contentengine
# DATABASE_URL is runtime/local data; TEST_DATABASE_URL is disposable automated-test data.
TEST_DATABASE_URL=postgresql+asyncpg://contentengine:contentengine@localhost:5432/contentengine_test
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Comma-separated exact browser origins. Wildcard '*' is rejected by the backend.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Research providers — leave empty until CE01 Research Spike.
SERPER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
RESEARCH_JINA_TOKEN_BUDGET=20000
RESEARCH_JINA_MAX_LINKS=100

# Optional only; not part of the default research path.
BRAVE_SEARCH_API_KEY=
